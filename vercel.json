{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/places/urgent-care/",
      "destination": "/places/hospitals/",
      "permanent": true
    },
    {
      "source": "/en/places/urgent-care/",
      "destination": "/en/places/hospitals/",
      "permanent": true
    },
    {
      "source": "/places/blood-donation/",
      "destination": "/places/blood-dialysis/?type=blood-donation",
      "permanent": true
    },
    {
      "source": "/en/places/blood-donation/",
      "destination": "/en/places/blood-dialysis/?type=blood-donation",
      "permanent": true
    },
    {
      "source": "/places/dialysis/",
      "destination": "/places/blood-dialysis/?type=dialysis",
      "permanent": true
    },
    {
      "source": "/en/places/dialysis/",
      "destination": "/en/places/blood-dialysis/?type=dialysis",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
