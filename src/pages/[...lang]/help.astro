---
import Base from '../../layouts/Base.astro';
import Directory from '../../components/Directory.astro';
import { HELP_GROUPS } from '../../content.js';
import { translator } from '../../i18n.js';
import { langPaths } from '../../routes.js';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
const t = translator(lang);
---

<Base lang={lang} slug="help" title={t('help.title')} description={t('help.intro')}>
  <h1>{t('help.title')}</h1>
  <p class="lead">{t('help.intro')}</p>
  <Directory lang={lang} groups={HELP_GROUPS} />
</Base>
