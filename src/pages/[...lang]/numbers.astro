---
import Base from '../../layouts/Base.astro';
import Directory from '../../components/Directory.astro';
import { LINES } from '../../content.js';
import { translator } from '../../i18n.js';
import { langPaths } from '../../routes.js';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
const t = translator(lang);
---

<Base lang={lang} slug="numbers" title={t('seo.numbers.title')} description={t('seo.numbers.desc')}>
  <h1>{t('seo.numbers.h1')}</h1>
  <p class="lead">{t('numbers.intro')}</p>
  <Directory lang={lang} groups={LINES} />
</Base>
