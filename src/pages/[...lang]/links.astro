---
import Base from '../../layouts/Base.astro';
import Directory from '../../components/Directory.astro';
import { LINKS } from '../../content.js';
import { translator } from '../../i18n.js';
import { langPaths } from '../../routes.js';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
const t = translator(lang);
---

<Base lang={lang} slug="links" title={t('links.title')} description={t('links.intro')}>
  <h1>{t('links.title')}</h1>
  <p class="lead">{t('links.intro')}</p>
  <Directory lang={lang} groups={LINKS} />
</Base>
