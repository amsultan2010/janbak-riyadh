---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Explorer from '../../components/Explorer.astro';
import places from '../../data/places.json';
import { CATEGORIES, GROUPS } from '../../categories.js';
import { translator, path } from '../../i18n.js';
import { langPaths } from '../../routes.js';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
const t = translator(lang);
const count = (id) => places.filter((p) => p.cat === id).length;
---

<Base lang={lang} title={t('home.title')} description={t('home.desc')} wide>
  <Explorer lang={lang}>
    <h1>{t('home.h1')}</h1>
    <p class="lead">{t('home.intro')}</p>
    <section slot="after" class="browse">
      <h2 class="label">{t('cat.browse')}</h2>
      {
        GROUPS.map((g) => (
          <>
            <h3 class="sub">{g[lang]}</h3>
            <ul class="rows">
              {CATEGORIES.filter((c) => c.group === g.id).map((c) => (
                <li>
                  <a href={path(lang, `places/${c.id}`)}>
                    <Icon name={c.id} tile />
                    {c[lang]}
                    <span class="count">{count(c.id)}</span>
                    <Icon name="chevron" flip />
                  </a>
                </li>
              ))}
            </ul>
          </>
        ))
      }
    </section>
  </Explorer>
</Base>
