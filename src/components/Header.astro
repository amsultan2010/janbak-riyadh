---
import Icon from './Icon.astro';
import { EMERGENCY } from '../categories.js';
import { MARK, WORD_BOX, word } from '../logo.js';
import { SITE, translator, path, otherLang } from '../i18n.js';

const { lang, slug } = Astro.props;
const t = translator(lang);
const other = otherLang(lang);
const section = slug.split('/')[0];
const nav = [
  { slug: '', key: 'nav.places', on: section === '' || section === 'places' },
  { slug: 'numbers', key: 'nav.numbers', on: section === 'numbers' },
  { slug: 'help', key: 'nav.help', on: section === 'help' },
  { slug: 'links', key: 'nav.links', on: section === 'links' },
];
---

<header>
  <div class="topbar">
    <a class="logo" href={path(lang)} aria-label={SITE[lang]}>
      <svg class="mark" viewBox="0 0 64 64" aria-hidden="true" set:html={MARK} />
      {
        lang === 'en' ? (
          <svg class="wordmark" viewBox={WORD_BOX} aria-hidden="true" set:html={word()} />
        ) : (
          <span class="wordmark-ar">{SITE.ar}</span>
        )
      }
    </a>
    <nav class="em" aria-label={t('em.label')}>
      <ul>
        {
          EMERGENCY.map((e) => (
            <li>
              <a href={`tel:${e.number}`} aria-label={`${t(e.key)} ${e.number}`}>
                <Icon name={e.icon} />
                <b>
                  <bdi dir="ltr">{e.number}</bdi>
                </b>
                <span>{t(e.key)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="subbar">
    <nav class="tabs" aria-label={t('nav.label')}>
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={path(lang, n.slug)} aria-current={n.on && n.slug === slug ? 'page' : n.on ? 'true' : undefined}>
                {t(n.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="ctl lang" href={path(other, slug)} lang={other} hreflang={other}>{t('lang.other')}</a>
  </div>
</header>
