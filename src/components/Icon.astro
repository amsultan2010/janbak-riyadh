---
import { ICONS, PICTURES } from '../icons.js';

// A category or emergency name gives its colour pictogram; anything else is a line icon.
const { name, flip = false } = Astro.props;
const picture = PICTURES[name];
---

{
  picture ? (
    <svg class="pic" viewBox="0 0 24 24" aria-hidden="true" set:html={picture} />
  ) : (
    <svg class:list={['icon', { flip }]} viewBox="0 0 24 24" aria-hidden="true">
      <path d={ICONS[name]} />
    </svg>
  )
}
