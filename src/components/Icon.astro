---
import { ICONS } from '../icons.js';

// `color` turns the icon into a filled tile of that colour
const { name, flip = false, color = null } = Astro.props;
---

<svg class:list={['icon', { flip, tile: color }]} style={color ? `--c:${color}` : undefined} viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS[name]}></path></svg>
