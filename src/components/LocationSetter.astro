---
import data from '../../research/districts.json';
import { translator } from '../i18n.js';
import { districtName } from '../lib/districts.js';

const { lang } = Astro.props;
const t = translator(lang);
const districts = data.districts
  .map((d) => ({ ...districtName(d), lat: d.lat, lng: d.lng }))
  .filter((d) => d.ar && d.en)
  .sort((a, b) => a[lang].localeCompare(b[lang], lang));
---

<section class="loc" data-loc aria-label={t('loc.title')} hidden>
  <p class="loc-state">
    <span data-loc-text>{t('loc.none')}</span>
    <button type="button" class="text-btn" data-loc-change hidden>{t('loc.change')}</button>
  </p>
  <div class="loc-form" data-loc-form>
    <button type="button" class="btn btn-fill" data-loc-gps>{t('loc.gps')}</button>
    <select data-loc-district aria-label={t('loc.pick')}>
        <option value="">{t('loc.district')}</option>
        {districts.map((d) => <option value={`${d.lat},${d.lng}`} data-ar={d.ar} data-en={d.en}>{d[lang]}</option>)}
      </select>
    <button type="button" class="btn" data-loc-pick hidden>{t('loc.pickMap')}</button>
    <button type="button" class="text-btn" data-loc-remove hidden>{t('loc.remove')}</button>
    <p class="small" data-loc-msg role="status">{t('loc.privacy')}</p>
  </div>
</section>

<script>
  import '../scripts/location.js';
</script>
